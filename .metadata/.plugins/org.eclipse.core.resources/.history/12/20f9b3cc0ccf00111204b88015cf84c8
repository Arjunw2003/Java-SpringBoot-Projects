package com.jbk.service;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.jbk.dao.StudentDao;
import com.jbk.entities.Student;

@Service
public class StudentService {

	@Autowired
	StudentDao dao;

	public String insertData(Student std) {
		String msg = dao.inserData(std);
		return msg;
	}

	public String deleteData(int id) {
		String msg = dao.deleteData(id);
		return msg;
	}
	
	public Student getSingleData(int id) {
		Student s = dao.getSingleData(id);
		return s;
	}
	
	public List<Student> getAllData() {
		List<Student> list = dao.getAllData();
		return list;
	}
	
	public String updateData(Student std, int id) {
		String msg = dao.updateData(std, id);
		return msg
	}
}
