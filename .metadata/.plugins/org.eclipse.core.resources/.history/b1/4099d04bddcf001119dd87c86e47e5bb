package com.tka.dao;

import org.hibernate.Session;
import org.hibernate.SessionFactory;
import org.hibernate.Transaction;
import org.hibernate.query.Query;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Repository;

import com.tka.entities.Employee;

@Repository
public class EmployeeDao {

	@Autowired
	SessionFactory factory;

	public String insertData(Employee emp) {

		Session s = factory.openSession();
		Transaction tr = s.beginTransaction();

		s.persist(emp);
		tr.commit();

		return "Data Inserted...";
	}

	public String updateData(Employee emp, int id) {

		Session s = factory.openSession();
		Transaction tr = s.beginTransaction();

		Employee e = s.find(Employee.class, id);
		e.setEmpName(emp.getEmpName());
		e.setEmpAge(emp.getEmpAge());
		e.setEmpcity(emp.getEmpcity());
		e.setSallary(emp.getSallary());

		s.merge(e);
		tr.commit();
		s.close();
		return "Data Updated...!";
	}

	public String deleteData(int id) {

		Session s = factory.openSession();
		Transaction tr = s.beginTransaction();

		Employee e = s.find(Employee.class, id);
		s.remove(e);
		tr.commit();

		return "Data Deleted...!";
	}
	
	public Employee getSingleData(int id) {
		Session s = factory.openSession();
		Transaction tr = s.beginTransaction();
		
		Employee e = s.find(Employee.class, id);
		
		return e;
		
	}
	
	public void getAllData() {
		Session s = factory.openSession();
		Transaction tr = s.beginTransaction();
		
		Query<Employee> query = s.createQuery("from Employee", Employee.class);
	}

	
		
	}

}
